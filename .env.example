# Copy this file to .env and fill in local values.
# NEVER commit .env to Git. This file contains placeholders only.

# Runtime
V52_ENV=development

# RPC providers. Keep these backend-only; never expose them through VITE_*.
ALCHEMY_ETH_RPC_URL=
ALCHEMY_AVAX_RPC_URL=
HSK_RPC_URL=
RPC_TIMEOUT_MS=12000
RPC_MAX_RETRIES=2

# Optional overrides. Defaults: Ethereum 1, Avalanche 43114, HSK 177.
ALCHEMY_ETH_CHAIN_ID=1
ALCHEMY_AVAX_CHAIN_ID=43114
HSK_CHAIN_ID=177

# Legacy fallback for the old Ethereum-only provider. Prefer ALCHEMY_ETH_RPC_URL.
V52_RPC_URL=

# The Graph decentralized gateway.
# Subgraph: Uniswap V3 (Ethereum Mainnet)
# Subgraph ID: 5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
V52_GRAPH_API_KEY=
V52_GRAPH_ENDPOINT=https://gateway.thegraph.com/api/{api_key}/subgraphs/id/5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# Evidence Vault
V52_DATA_DIR=./evidence_vault

# Storage backend (file | mongo)
V52_STORAGE_BACKEND=file

# MongoDB Atlas (P1)
V52_MONGODB_URI=
V52_MONGODB_DATABASE=vector52

# Upstash Redis (optional)
V52_CACHE_ENABLED=false
V52_UPSTASH_REDIS_REST_URL=
V52_UPSTASH_REDIS_REST_TOKEN=
V52_CACHE_TTL_SECONDS=120

# AI explanation (optional, non-authoritative)
V52_AI_ENABLED=false
V52_AI_API_KEY=

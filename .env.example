# Copy this file to .env and fill in local values.
# NEVER commit .env to Git. This file contains placeholders only.

# ── Runtime Environment ───────────────────────────────────────────────────────
V52_ENV=development
# Production: V52_ENV=production

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call FastAPI.
# Development: http://localhost:5173,http://127.0.0.1:5173
# Production example: https://v52-chain.vercel.app/
V52_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public frontend origin for redirects and integration
V52_PUBLIC_ORIGIN=http://localhost:5173
# Production: https://v52-chain.vercel.app/

# ── RPC Providers (Keep backend-only; never expose via VITE_*) ────────────────
# CRITICAL: Get a single API key from Alchemy dashboard
# (https://dashboard.alchemy.com/apps) and set ALCHEMY_API_KEY.
# The backend builds the Ethereum and Avalanche RPC URLs automatically.
ALCHEMY_API_KEY=

# Advanced override: set a full RPC URL per network (optional).
# Only needed for custom Alchemy app URL or non-Alchemy JSON-RPC endpoint.
# Leave empty when ALCHEMY_API_KEY is set.
ALCHEMY_ETH_RPC_URL=
ALCHEMY_AVAX_RPC_URL=

# HSK is not offered by Alchemy; it always needs its own RPC endpoint.
# Testnet (chain 133): https://testnet.hsk.xyz — Mainnet (chain 177): https://mainnet.hsk.xyz
HSK_RPC_URL=

# RPC Configuration
RPC_TIMEOUT_MS=12000
RPC_MAX_RETRIES=2

# Optional chain ID overrides. Defaults: Ethereum 1, Avalanche 43114, HSK 177.
# Set ALCHEMY_AVAX_CHAIN_ID=43113 to use Fuji Testnet instead of Mainnet.
# Set HSK_CHAIN_ID=133 to match the current HSK testnet deployment.
ALCHEMY_ETH_CHAIN_ID=1
ALCHEMY_AVAX_CHAIN_ID=43114
HSK_CHAIN_ID=177

# ── HSK network switch (testnet ⇄ mainnet) ────────────────────────────────────
# Set HSK_NETWORK to "testnet" or "mainnet" to auto-resolve HSK_RPC_URL,
# HSK_CHAIN_ID, HSK_EVIDENCE_REGISTRY_ADDRESS and HSK_EXPLORER_URL from the
# deployments published in v52-onchain/deployments/hsk-{testnet,mainnet}.json
# (mirrored in app/config.py _HSK_NETWORK_DEFAULTS) — no need to copy each
# value by hand. Any of the four HSK_* variables above/below set explicitly
# still wins over the HSK_NETWORK default for that one field. Leaving
# HSK_NETWORK empty keeps the legacy behavior (chain_id 177, testnet
# explorer, empty RPC/address until set explicitly).
# HSK_NETWORK=testnet
# HSK_NETWORK=mainnet

# ── HSK V52EvidenceRegistry (manifest anchoring) ──────────────────────────────
# Anchors sha256(manifest.json) + a methodology hash + schema_version +
# case_id on HSK. See v52-onchain/contracts/hsk/V52EvidenceRegistry.sol and
# v52-onchain/deployments/hsk-{testnet,mainnet}.json for the live addresses
# (testnet 0x3422820Ef9FBC8e0206E4CBcB6369dBd14BE18c4, mainnet
# 0xf7565Ec1e00206955286B8536c779A7221E62A9c — both already wired as
# HSK_NETWORK defaults, so these two only need to be set to override).
# GET /v1/anchors/{root} only needs the two lines below (read-only).
HSK_EVIDENCE_REGISTRY_ADDRESS=
HSK_EXPLORER_URL=https://testnet-explorer.hsk.xyz
# POST /v1/cases/{id}/anchor additionally needs a funded signer key — this
# wallet pays HSK gas and must be allow-listed as an issuer on the registry
# (see setIssuer() in the contract). NEVER commit a real key here. Mainnet
# and testnet keys must never be the same wallet/value — see
# v52-onchain/SECURITY.md and the mainnet security note in
# v52-onchain/README.md (owner/issuer reuses X402_AGENT_PRIVATE_KEY today;
# rotate before treating mainnet anchoring as production infrastructure).
HSK_ANCHOR_PRIVATE_KEY=
# Advanced overrides (defaults shown):
# HSK_ANCHOR_GAS_LIMIT=400000
# HSK_METHODOLOGY_VERSION=v52-contribution-0.1.0

# Legacy fallback for old Ethereum-only provider. Prefer ALCHEMY_API_KEY.
V52_RPC_URL=

# ── The Graph (Decentralized Network Gateway) ──────────────────────────────────
# Subgraph: Uniswap V3 (Ethereum Mainnet)
# Subgraph ID: 5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
#
# The Graph API Key (optional; improves rate limits and reliability)
# Get from: https://thegraph.com/studio
V52_GRAPH_API_KEY=

# Query endpoint (uses {api_key} placeholder if API key is set)
V52_GRAPH_ENDPOINT=https://gateway.thegraph.com/api/{api_key}/subgraphs/id/5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# ── The Graph — Multi-chain DeFi Subgraph Intel (HSK / Avalanche / Ethereum) ──
# Powers GET /v1/intel/defi/status (free) and POST /v1/agent/intel/defi/*
# (x402-paid). See docs/SUBGRAPHS.md for how to pick a subgraph per chain.
# Each chain is fully optional and independent — an unset chain reports
# UNCONFIGURED honestly instead of a backend guessing at data.
#
# Ethereum falls back to V52_GRAPH_ENDPOINT/V52_GRAPH_API_KEY above when
# these are left empty, so existing single-chain setups keep working as-is.
V52_GRAPH_ENDPOINT_ETHEREUM=
V52_GRAPH_API_KEY_ETHEREUM=
V52_GRAPH_SCHEMA_ETHEREUM=uniswap_v3

# Avalanche C-Chain: point this at a Trader Joe / Pangolin (or similar)
# subgraph found via https://thegraph.com/explorer — most AMM subgraphs on
# Avalanche fork the Uniswap V2 schema (pairs/reserve0/reserve1).
V52_GRAPH_ENDPOINT_AVALANCHE=
V52_GRAPH_API_KEY_AVALANCHE=
V52_GRAPH_SCHEMA_AVALANCHE=uniswap_v2

# HSK Chain: no public subgraph is currently published for HSK. Deploy the
# scaffold in subgraph/hsk-core/ (see subgraph/hsk-core/README.md and
# https://docs.hskchain.net/docs/Build-on-HashKey-Chain/Tools/Subgraph) and
# point this at the resulting query URL once it is indexing.
V52_GRAPH_ENDPOINT_HSK=
V52_GRAPH_API_KEY_HSK=
V52_GRAPH_SCHEMA_HSK=uniswap_v2

# ── Evidence Vault ────────────────────────────────────────────────────────────
V52_DATA_DIR=./evidence_vault

# ── Storage Backend (file | mongo) ────────────────────────────────────────────
V52_STORAGE_BACKEND=file

# ── MongoDB Atlas (Phase 1 — optional for production) ─────────────────────────
V52_MONGODB_URI=
V52_MONGODB_DATABASE=vector52

# ── Upstash Redis (Optional — only if latency/rate-limit is measured) ─────────
V52_CACHE_ENABLED=false
V52_UPSTASH_REDIS_REST_URL=
V52_UPSTASH_REDIS_REST_TOKEN=
V52_CACHE_TTL_SECONDS=120

# ── AI Explanation (Non-authoritative, optional) ──────────────────────────────
V52_AI_ENABLED=false
V52_AI_API_KEY=

# ── x402 Payment Channel (Avalanche Fuji + USDC) ──────────────────────────────
# Keep disabled until /supported, /verify AND /settle are proven end-to-end.
V52_X402_ENABLED=false
# Bare facilitator domain — NO trailing path. Verified 2026-09-12: the live
# facilitator (x402-facilitator-local) exposes FLAT routes (/supported,
# /verify, /settle) directly on this domain. Do NOT append
# /api/v1/plugins/x402/call — that OpenZeppelin Relayer plugin prefix (used
# in v52-onchain/x402-test) 404s against this facilitator.
# Example: https://your-tunnel.ngrok-free.dev
V52_X402_FACILITATOR_URL=
V52_X402_FACILITATOR_API_KEY=
V52_X402_PAY_TO=
V52_X402_NETWORK=eip155:43113
V52_X402_ASSET=0x5425890298aed601595a70AB815c96711a31Bc65
# 1000 atomic USDC units = 0.001 USDC (6 decimals)
V52_X402_WALLET_FLOW_PRICE=1000
# DeFi Subgraph Intel pricing tiers (see docs/SUBGRAPHS.md §4) — priced by
# query cost/value: pools listing < per-pool activity drill-down < full
# multi-chain scan.
V52_X402_DEFI_POOLS_PRICE=400
V52_X402_DEFI_POOL_ACTIVITY_PRICE=900
V52_X402_DEFI_SCAN_PRICE=2500

# ── MCP Agent Access Integration (Optional) ───────────────────────────────────
# v52-mcp is a separate repository/service. Leave empty until it is deployed
# and its connectivity is verified — /v1/integrations/mcp/* honestly reports
# UNAVAILABLE while this is unset. Do not point this at a mock server.
V52_MCP_SERVER_URL=

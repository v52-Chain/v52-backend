# Copy this file to .env and fill in local values.
# NEVER commit .env to Git — it is excluded by .gitignore.
# All variables are optional in development; required values are validated at startup.

# ── Runtime environment ───────────────────────────────────────────────────────
V52_ENV=development

# Comma-separated browser origins allowed to call FastAPI.
# Production example: https://vector52.vercel.app,https://app.vector52.xyz
# Do not use * for the Buildathon deployment.
V52_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Ethereum RPC (Infura, Alchemy, or any JSON-RPC endpoint) ──────────────────
# Required for live evidence acquisition. Leave empty to run in stub-only mode.
V52_RPC_URL=

# ── The Graph (Decentralized Network Gateway) ──────────────────────────────────
# Subgraph: Uniswap-V3 (Ethereum Mainnet)
# Subgraph ID: 5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Deployment IPFS: QmTZ8ejXJxRo7vDBS4uwqBeGoxLSWbhaA7oXa1RvxunLy7
# Set your Graph Studio API Key (or leave blank if included in endpoint):
V52_GRAPH_API_KEY=
# Query endpoint (Gateway URL with {api_key} placeholder or direct):
V52_GRAPH_ENDPOINT=https://gateway.thegraph.com/api/{api_key}/subgraphs/id/5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# ── Evidence Vault ────────────────────────────────────────────────────────────
V52_DATA_DIR=./evidence_vault

# ── Storage backend (file | mongo) ───────────────────────────────────────────
V52_STORAGE_BACKEND=file

# ── MongoDB Atlas (P1 — activate after file-backed flow works) ────────────────
V52_MONGODB_URI=
V52_MONGODB_DATABASE=vector52

# ── Upstash Redis (optional — only if latency/rate-limit is measured) ─────────
V52_CACHE_ENABLED=false
V52_UPSTASH_REDIS_REST_URL=
V52_UPSTASH_REDIS_REST_TOKEN=
V52_CACHE_TTL_SECONDS=120

# ── AI explanation (non-authoritative, optional) ─────────────────────────────
V52_AI_ENABLED=false
V52_AI_API_KEY=
